<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:ps="Playsmart.UIToolkit"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
    <Style src="Demo.uss" />

    <ui:VisualElement class="demo-screen">
        <!-- Header -->
        <ui:Label text="UI TOOLKIT EXTENSIONS DEMO" class="demo-title" />

        <!-- Gap Container with Skewed Buttons inside -->
        <ps:Gap class="menu-container">
            <ps:SkewButton text="PLAY GAME" class="menu-btn" />
            <ps:SkewButton text="SETTINGS" class="menu-btn" />
            <ps:SkewButton text="EXIT" class="menu-btn" />
        </ps:Gap>
    </ui:VisualElement>
</ui:UXML>
