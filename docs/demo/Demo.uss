.demo-screen {
	width: 100%;
	height: 100%;
	background-color: #0b0914;
	padding: 40px;
	justify-content: center;
	align-items: center;
}

.demo-title {
	color: #ffffff;
	font-size: 24px;
	margin-bottom: 40px;
}

/* Gap Container */
.menu-container {
	flex-direction: row;

	--gap: 20;

	justify-content: center;
	align-items: center;
}

/* SkewButton Styling */
.menu-btn {
	width: 160px;
	height: 48px;
	background-color: transparent;
	border-width: 0;
	margin: 0;
	padding: 0;

	--skew-angle: 15;
	--skew-fill-color: rgba(20, 20, 35, 0.8);
	--skew-stroke-color: #00f0ff;
	--skew-text-color: #ffffff;
	font-size: 14px;
}

.menu-btn:hover {
	--skew-stroke-color: #ff0055;
	--skew-fill-color: rgba(40, 20, 45, 0.9);
}